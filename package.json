{
  "name": "lyrics-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:pages": "ng build --configuration production --base-href \"/LyricsFront/\"",
    "prep:pages": "node -e \"const fs=require('fs'),p=require('path');function findIndex(dir,depth=0){if(depth>3)return null;for(const e of fs.readdirSync(dir,{withFileTypes:true})){const full=p.join(dir,e.name);if(e.isFile()&&e.name==='index.html')return dir;if(e.isDirectory()){const hit=findIndex(full,depth+1);if(hit)return hit;}}return null;}const out=findIndex('dist');if(!out){console.error('no dist/**/index.html');process.exit(1);}fs.copyFileSync(p.join(out,'index.html'),p.join(out,'404.html'));process.stdout.write(out);\"",
    "deploy:pages": "npx angular-cli-ghpages --dir \"$(npm run -s prep:pages)\" --branch gh-pages --message \"deploy $(date -Iseconds)\"",
    "deploy": "npm run build:pages && npm run deploy:pages"
  },
  "browser": {
    "crypto": false,
    "constants": false,
    "fs": false,
    "path": false
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^14.1.0",
    "@angular/cdk": "^14.2.7",
    "@angular/common": "^14.1.0",
    "@angular/compiler": "^14.1.0",
    "@angular/core": "^14.1.0",
    "@angular/forms": "^14.1.0",
    "@angular/material": "^14.2.7",
    "@angular/platform-browser": "^14.1.0",
    "@angular/platform-browser-dynamic": "^14.1.0",
    "@angular/router": "^14.1.0",
    "@auth0/auth0-angular": "^1.11.0",
    "bootstrap": "^5.3.0-alpha1",
    "buffer": "^6.0.3",
    "Buffer": "^0.0.0",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.1.0",
    "@angular/cli": "^14.2.13",
    "@angular/compiler-cli": "^14.1.0",
    "@types/jasmine": "~4.0.0",
    "@types/node": "16.18.11",
    "angular-cli-ghpages": "^1.0.3",
    "jasmine-core": "~4.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "4.8.4"
  }
}
